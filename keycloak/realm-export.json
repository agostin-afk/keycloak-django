{
  "realm": "demo",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administrador do sistema",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "user",
        "description": "Usuário comum",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "auditor",
        "description": "Auditor (somente leitura)",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@demo.local",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin",
        "user"
      ]
    },
    {
      "username": "aluno",
      "enabled": true,
      "email": "aluno@demo.local",
      "emailVerified": true,
      "firstName": "Aluno",
      "lastName": "Teste",
      "credentials": [
        {
          "type": "password",
          "value": "aluno123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user"
      ]
    },
    {
      "username": "auditor",
      "enabled": true,
      "email": "auditor@demo.local",
      "emailVerified": true,
      "firstName": "Auditor",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "auditor123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "auditor",
        "user"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "django-app",
      "name": "Django Demo App",
      "enabled": true,
      "publicClient": false,
      "secret": "django-secret-change-me",
      "redirectUris": [
        "http://localhost:8000/*",
        "http://127.0.0.1:8000/*",
        "http://localhost:8000/callback/"
      ],
      "webOrigins": [
        "http://localhost:8000",
        "http://127.0.0.1:8000",
        "+"
      ],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        }
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email",
        "basic"
      ],
      "optionalClientScopes": [
        "offline_access",
        "address",
        "phone",
        "microprofile-jwt"
      ],
      "fullScopeAllowed": true
    }
  ]
}